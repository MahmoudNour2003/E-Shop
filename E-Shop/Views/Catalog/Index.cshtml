@model E_Shop.Models.ProductListVM

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Product Catalog</h1>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="q" class="form-label">Search</label>
                <input id="q" type="text" name="q" value="@Model.Query" class="form-control"
                    placeholder="Search products" />
            </div>

            <div class="col-md-3">
                <label for="categoryId" class="form-label">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        if (Model.CategoryId == category.CategoryId)
                        {
                            <option value="@category.CategoryId" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.CategoryId">@category.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label for="sort" class="form-label">Sort</label>
                <select id="sort" name="sort" class="form-select">
                    @if (Model.Sort == "name")
                    {
                        <option value="name" selected>Name</option>
                    }
                    else
                    {
                        <option value="name">Name</option>
                    }

                    @if (Model.Sort == "price_asc")
                    {
                        <option value="price_asc" selected>Price: Low to High</option>
                    }
                    else
                    {
                        <option value="price_asc">Price: Low to High</option>
                    }

                    @if (Model.Sort == "price_desc")
                    {
                        <option value="price_desc" selected>Price: High to Low</option>
                    }
                    else
                    {
                        <option value="price_desc">Price: High to Low</option>
                    }

                    @if (Model.Sort == "newest")
                    {
                        <option value="newest" selected>Newest</option>
                    }
                    else
                    {
                        <option value="newest">Newest</option>
                    }
                </select>
            </div>

            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">No products found.</div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">
                            <a asp-action="Details" asp-route-id="@product.ProductId"
                                class="text-decoration-none">@product.Name</a>
                        </h5>
                        <p class="text-muted small mb-3">SKU: @product.SKU</p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@product.Price.ToString("C")</span>
                            <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Catalog pagination">
        <ul class="pagination mb-0">
            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-q="@Model.Query"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.Page - 1)">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Previous</span></li>
            }

            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>

            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-q="@Model.Query"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.Page + 1)">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Next</span></li>
            }
        </ul>
    </nav>
}