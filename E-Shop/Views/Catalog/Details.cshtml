@model E_Shop.Models.ProductDetailsVM

@{
    ViewData["Title"] = Model.Product.Name;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Catalog" asp-action="Index">Catalog</a>
        </li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.Category.CategoryId">@Model.Category.Name</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
    </ol>
</nav>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h1 class="h3 mb-2">@Model.Product.Name</h1>
                <p class="text-muted mb-3">SKU: @Model.Product.SKU</p>

                @if (Model.Category != null)
                {
                    <p class="mb-3">
                        <span class="text-muted">Category:</span>
                        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.Category.CategoryId" class="text-decoration-none ms-1">@Model.Category.Name</a>
                    </p>
                }

                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="fs-4 fw-bold">@Model.Product.Price.ToString("C")</span>
                    @if (Model.Product.StockQuantity > 0)
                    {
                        <span class="badge text-bg-success">In Stock (@Model.Product.StockQuantity)</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">Out of Stock</span>
                    }
                </div>

                <p class="text-muted mb-0">Added: @Model.Product.CreatedAt.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Buy Now</strong>
            </div>
            <div class="card-body">
                <form method="post" asp-controller="Cart" asp-action="Add" class="d-grid gap-3">
                    <input type="hidden" name="productId" value="@Model.Product.ProductId" />

                    <div>
                        <label for="quantity" class="form-label">Quantity</label>
                        @if (Model.Product.StockQuantity > 0)
                        {
                            <input id="quantity" type="number" name="quantity" value="1" min="1" max="@Model.Product.StockQuantity" class="form-control" />
                        }
                        else
                        {
                            <input id="quantity" type="number" name="quantity" value="1" min="1" class="form-control" disabled />
                        }
                    </div>

                    @if (Model.Product.StockQuantity > 0)
                    {
                        <button type="submit" class="btn btn-primary">Add to Cart</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-secondary" disabled>Add to Cart</button>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.RelatedProducts.Any())
{
    <section class="mb-4">
        <h2 class="h4 mb-3">Related Products</h2>
        <div class="row g-3">
            @foreach (var item in Model.RelatedProducts)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-1">
                                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none">@item.Name</a>
                            </h6>
                            <div class="text-muted small mb-3">SKU: @item.SKU</div>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-semibold">@item.Price.ToString("C")</span>
                                @if (item.StockQuantity == 0)
                                {
                                    <span class="badge text-bg-danger">Out of Stock</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<div>
    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.Category?.CategoryId" class="btn btn-outline-secondary">&larr; Back to @(Model.Category?.Name ?? "Catalog")</a>
</div>

