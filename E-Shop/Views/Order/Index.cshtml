@model IEnumerable<E_Shop.Models.CustomerOrderVM>

@{
    ViewData["Title"] = "My Orders";
}

<h1 class="mb-3">My Orders</h1>

@if (TempData["OrderMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You don't have any orders yet.</div>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Browse Products</a>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var statusText = order.Status switch
                    {
                        0 => "Pending",
                        1 => "Paid",
                        2 => "Shipped",
                        3 => "Delivered",
                        4 => "Cancelled",
                        _ => "Unknown"
                    };

                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@statusText</td>
                        <td class="text-end">@order.TotalAmount.ToString("C")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
